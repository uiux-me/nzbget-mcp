# Copy to .env and edit. Compose reads it automatically.

# --- NZBGet ------------------------------------------------------------------
# Credentials for the bundled NZBGet. These are the documented defaults —
# change them before pointing this at a real news server.
NZBGET_USERNAME=nzbget
NZBGET_PASSWORD=tegbzn6789

# Host port for NZBGet's web UI (bound to 127.0.0.1).
NZBGET_PORT=6789

# Ownership of files written to ./completed.
PUID=1000
PGID=1000
TZ=UTC

# --- MCP server --------------------------------------------------------------
# Host port for the MCP endpoint (bound to 127.0.0.1). The endpoint has no
# authentication, so keep it on loopback.
MCP_PORT=8080
MCP_PATH=/mcp

# HTTP timeout when calling NZBGet, in seconds.
NZBGET_TIMEOUT=30

# true registers only the read tools (no adding, deleting, pausing, reloading).
NZBGET_READ_ONLY=false

# true additionally registers shutdown_server.
NZBGET_ALLOW_SHUTDOWN=false

LOG_LEVEL=info

# --- Release search (optional) -----------------------------------------------
# Search needs a Newznab indexer. Your usenet provider is NOT one: Newshosting
# and friends sell access to the articles, while an indexer sells the
# searchable catalogue of what is out there. You need both.
#
# Any Newznab-compatible endpoint works, including the aggregators
# (NZBHydra2, Prowlarr), which present their own Newznab endpoint.
# Numbering must be contiguous — the scan stops at the first gap.

# INDEXER1_URL=https://api.nzbgeek.info
# INDEXER1_APIKEY=your-api-key
# INDEXER1_NAME=nzbgeek                # optional, defaults to the hostname
# INDEXER1_CATEGORIES=                 # optional, numeric Newznab ids

# INDEXER2_URL=https://nzbfinder.ws
# INDEXER2_APIKEY=your-api-key

# Set false to turn search off without deleting the config above.
SEARCH_ENABLED=true
SEARCH_TIMEOUT=20
SEARCH_CACHE_TTL=900

# --- News server / provider (optional) ---------------------------------------
# Your usenet provider — where NZBGet actually downloads articles from.
# Applied into NZBGet's config at startup, so this file stays the source of
# truth even if the config volume is recreated.
#
# With a preset, host/port/encryption/connections are filled in for you:
#   newshosting, usenetserver, eweka
# NEWS_SERVER_PROVIDER=newshosting
# NEWS_SERVER_USERNAME=your-username
# NEWS_SERVER_PASSWORD=your-password

# Raise to what your plan allows — Newshosting permits 30 on Limited and
# up to 100 on Unlimited/XL. Too many gets refused by the provider.
# NEWS_SERVER_CONNECTIONS=30

# For any other provider, set these instead of NEWS_SERVER_PROVIDER:
# NEWS_SERVER_HOST=news.example.net
# NEWS_SERVER_PORT=563
# NEWS_SERVER_ENCRYPTION=yes
# NEWS_SERVER_NAME=my-provider
# NEWS_SERVER_SLOT=1          # 2, 3… for backup providers
# NEWS_SERVER_LEVEL=0         # higher levels are fallbacks tried in order
